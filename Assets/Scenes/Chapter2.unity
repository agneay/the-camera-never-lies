  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c7f653c067b9a6e4ca7d2ef760e43cc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  prompt: Interact
  noteTitle: "Apartment 3A \u2014 a note on the side table"
  body: "Ada wound the hall clock every night. The night she disappeared, it stopped
    \u2014 and I hid the spare stairwell fuse inside it.\n\nThe case only opens if
    you wind it at the hour she stopped it.\n\nThe lens will show you a time. Don't
    believe it. Every photograph since midnight has lied to me.\n\nThere is one picture
    of the clock taken that evening, BEFORE midnight. I stuck it to the fridge."
  flagOnRead: read_clock_note
  objectiveOnRead: Set the hall clock in 3A to the hour Ada stopped it. Find the
    photo taken before midnight.
  hintOnRead: 
