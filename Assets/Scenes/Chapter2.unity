MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1310080918}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c7f653c067b9a6e4ca7d2ef760e43cc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  prompt: Interact
  noteTitle: Pinned to the table, in the photographer's hand
  body: "You came through the darkroom. Then you've seen it.\n\nIt follows whoever
    holds the camera. Through the lens it cannot move \u2014 but it hates being watched,
    and it won't stay still for long. The flash drives it off. Film is scarce: don't
    waste it.\n\nThe stairwell is the only way down. Its lock needs power, and it
    needs a key.\n\nDon't photograph the doll. And only trust photographs taken BEFORE
    midnight.\n\n\u2014 M."
  flagOnRead: read_intro2
  objectiveOnRead: Find a way down. The stairwell lock needs power (a fuse) and a
    key.
  hintOnRead: Every photograph costs film. You have 4.
