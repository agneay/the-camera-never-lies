  m_Script: {fileID: 11500000, guid: c7f653c067b9a6e4ca7d2ef760e43cc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  prompt: Interact
  noteTitle: A message, addressed to you
  body: "If you are reading this, the camera found its way to you.\n\nDo not trust
    any photograph taken after midnight.\n\nThe studio is through the east wall.
    The door is still there \u2014 you just can't see it. Look through the lens.
    What the camera sees, it can make real.\n\n\u2014 M. Voss"
  flagOnRead: read_intro
  objectiveOnRead: Find a way into the studio. Look at the east wall through the
    camera.
  hintOnRead: '[Right Mouse] Raise the camera'
